const int BUTTON_PIN = 13;
const int TRIG_PIN   = 12;
const int ECHO_PIN   = 14;

void setup() {
  Serial.begin(115200);
  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  
  // Ensure trigger starts LOW
  digitalWrite(TRIG_PIN, LOW);
}

void loop() {
  // Read button (1 = Pressed, 0 = Up)
  int buttonState = (digitalRead(BUTTON_PIN) == LOW) ? 1 : 0;

  // Trigger Ultrasonic
  digitalWrite(TRIG_PIN, LOW); delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH); delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  float distance = (duration > 0) ? (duration * 0.0343 / 2.0) : 40.0;
  
  // Cap the distance to 40cm so the game cursor doesn't fly off screen
  if(distance > 40.0 || distance < 2.0) distance = 40.0;

  // Print CSV format for Processing: "distance,buttonState"
  Serial.print(distance);
  Serial.print(",");
  Serial.println(buttonState);

  delay(30); // ~33 fps refresh rate
}
